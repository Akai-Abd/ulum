<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Universal Linux Update Manager</vendor>
  <vendor_url>https://github.com/universal-linux-tools/ulum</vendor_url>
  <icon_name>ulum</icon_name>
  <action id="org.ulum.pkexec.gui">
    <description>Run Universal Linux Update Manager as Administrator</description>
    <message>Authentication is required to run Universal Linux Update Manager as Administrator</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ulum-gui</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
